{
  "permissions": {
    "allow": [
      "Edit(/frontend/**)",
      "Edit(/backend/**)",
      "Skill(tumeda-dev:steering)",
      "Edit(/.steering/**)",
      "Skill(tumeda-dev:doc-enricher)",
      "READ(/tmp/**)",
      "Edit(/tmp/**)",
      "Edit(/frontend/inspect/visual/tmp/**)",
      "Bash(node:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(bash scripts/github/create_pr_from_branch_name.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/think_through_session_start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/think_through_user_prompt.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review_response.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review_response.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -qE 'cat[[:space:]]*<<' && ! echo \"$cmd\" | grep -qE '\\$\\(cat[[:space:]]*<<'; then printf '{\"continue\":false,\"stopReason\":\"cat heredoc によるファイル作成は禁止です。Write ツールを使ってください\"}'; fi"
          }
        ]
      }
    ]
  }
}
