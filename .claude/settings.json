{
  "permissions": {
    "allow": [
      "Edit(/frontend/**)",
      "Edit(/backend/**)",
      "Skill(steering)",
      "Edit(/.steering/**)",
      "Skill(doc-enricher)",
      "READ(/tmp/**)",
      "Edit(/tmp/**)",
      "Edit(/frontend/inspect/visual/tmp/**)",
      "Bash(node:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review_response.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review_response.py"
          }
        ]
      }
    ]
  }
}
