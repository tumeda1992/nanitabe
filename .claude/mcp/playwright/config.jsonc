{
  // 自動テスト通過済みの前提で画面スクショを確認する用途のため、
  // ログイン状態を保持できるよう isolated: false + userDataDir を使用する
  "browser": {
    "browserName": "chromium",
    "isolated": false,
    "userDataDir": "./frontend/inspect/visual/tmp/profile",
    "launchOptions": {
      "headless": true,
      "args": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]
    },
    "contextOptions": {
      "viewport": {
        "width": 1920,
        "height": 1080
      },
      "locale": "ja-JP",
      "timezoneId": "Asia/Tokyo"
    }
  },
  "outputDir": "./frontend/inspect/visual/tmp"
}
